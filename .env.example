DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments
PORT=3000
FAKE_BANK_URL=http://localhost:5000
REDIS_URL=redis://localhost:6379

# --- API tuning (Phase 4); defaults shown ---
# RATE_LIMIT_PER_MINUTE=100           per merchant, sliding window
# MERCHANT_CACHE_TTL_SECONDS=30       also the max delay before a revoked API key stops working
# PAYMENT_CACHE_TTL_SECONDS=300       terminal payments only
# ADMIN_TOKEN=                        required for GET /metrics; unset = endpoint disabled

# --- logging (Phase 6) ---
# LOG_LEVEL=info                      debug | info | warn | error
# SERVICE_NAME=gateway                the worker sets "worker" itself

# --- worker tuning (Phase 3); defaults shown ---
# RECONCILIATION_CRON=10 0 * * *      daily, UTC, reconciles the previous day
# RESOLUTION_INTERVAL_MS=30000        how often the PENDING resolution job runs
# PENDING_MIN_AGE_SECONDS=30          ignore PENDING payments younger than this
# STALE_PROCESSING_SECONDS=120        PROCESSING longer than this = abandoned, rescue it
# PENDING_GIVE_UP_SECONDS=900         bank still has no record after this -> FAILED
# OUTBOX_SWEEP_INTERVAL_MS=30000      how often undelivered webhooks are re-enqueued
# OUTBOX_SWEEP_MIN_AGE_SECONDS=30
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_BACKOFF_MS=2000             first retry delay; doubles each attempt
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_CONCURRENCY=10
